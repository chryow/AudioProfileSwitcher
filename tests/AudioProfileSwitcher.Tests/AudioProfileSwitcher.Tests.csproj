    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\..\ProfileLogic.cs" Link="Shared\ProfileLogic.cs" />
